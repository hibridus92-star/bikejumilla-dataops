<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bikejumilla_commercial_analysis_wizard_form" model="ir.ui.view">
        <field name="name">bikejumilla.commercial.analysis.wizard.form</field>
        <field name="model">bikejumilla.commercial.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Analizador comercial BikeJumilla">
                <sheet>
                    <group string="Periodo"><field name="date_from"/><field name="date_to"/></group>
                    <group string="Filtros">
                        <group><field name="salesperson_id"/><field name="partner_id"/><field name="product_category_id"/></group>
                        <group><field name="order_state"/><field name="min_amount"/><field name="currency_id" invisible="1"/></group>
                    </group>
                    <group string="Resultado provisional"><field name="result_count"/><field name="result_amount"/></group>
                    <div class="text-muted">TODO alumno: completar consulta, presentación y validación de resultados.</div>
                </sheet>
                <footer>
                    <button name="action_analyze" string="Analizar" type="object" class="btn-primary"/>
                    <button name="action_print_report" string="Generar informe" type="object" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_bikejumilla_commercial_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Analizador comercial</field>
        <field name="res_model">bikejumilla.commercial.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
