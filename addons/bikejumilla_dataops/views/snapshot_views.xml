<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bikejumilla_dataops_snapshot_list" model="ir.ui.view">
        <field name="name">bikejumilla.dataops.snapshot.list</field>
        <field name="model">bikejumilla.dataops.snapshot</field>
        <field name="arch" type="xml">
            <list string="Snapshots de indicadores" create="false">
                <field name="name"/>
                <field name="execution_datetime"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_operations"/>
                <field name="amount_total"/>
                <field name="extra_metric"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_bikejumilla_dataops_snapshot_form" model="ir.ui.view">
        <field name="name">bikejumilla.dataops.snapshot.form</field>
        <field name="model">bikejumilla.dataops.snapshot</field>
        <field name="arch" type="xml">
            <form string="Snapshot de indicadores" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="execution_datetime"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Indicadores">
                        <field name="total_operations"/>
                        <field name="amount_total"/>
                        <field name="extra_metric"/>
                    </group>
                    <group string="Observaciones"><field name="notes"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bikejumilla_dataops_snapshots" model="ir.actions.act_window">
        <field name="name">Snapshots</field>
        <field name="res_model">bikejumilla.dataops.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
